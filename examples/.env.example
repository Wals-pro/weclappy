# Copy to a private file, replace the placeholders, then export the values.
# The examples intentionally do not load .env files or require python-dotenv.
# Use a sandbox or test tenant; never point write examples at production data.

# Tenant name (acme -> https://acme.weclapp.com/webapp/api/v2/) or full host.
WECLAPP_TENANT=acme
WECLAPP_API_KEY=your_api_key

# Required only by examples that perform writes:
# WECLAPP_ENABLE_WRITES=1
# WECLAPP_ENTITY_NAME=salesOrder
# WECLAPP_ENTITY_ID=12345
# WECLAPP_UPLOAD_FILE=/absolute/path/to/document.pdf

# Required only by unofficial_endpoints.py:
# WECLAPP_ENABLE_UNOFFICIAL=1

# Optional for load_management_demo.py and export_with_keyset.py:
# WECLAPP_DEMO_ENTITY=article
# WECLAPP_DEMO_LIMIT=5000
# WECLAPP_START_AFTER=
# WECLAPP_EXPORT_LIMIT=1000

# Required only by the read-only live contract probe (live_contract.py),
# which takes a full base URL instead of a tenant name:
# WECLAPP_BASE_URL=https://acme.weclapp.com/webapp/api/v2
# WECLAPP_RUN_LIVE_CONTRACT=1
# WECLAPP_LIVE_CONTRACT_LIMIT=3
# Required for webhook server mode, including on loopback:
# WECLAPP_LIVE_CONTRACT_BEARER_TOKEN=use_a_separate_high_entropy_token
